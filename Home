import React, { useState, useEffect } from 'react';
import { Terminal, Send, Activity, Shield, Cpu, Zap } from 'lucide-react';

const SovereignShell = () => {
  const [input, setInput] = useState('');
  const [logs, setLogs] = useState([
    { agent: 'SYS', msg: 'NEURAL LINK ESTABLISHED. IDENTITY: PURGER2025' },
    { agent: 'TWINS', msg: 'THE FORGE IS HOT. STANDING BY FOR MISSION.' }
  ]);

  const executeCommand = async () => {
    if (!input.trim()) return;

    // 1. Log User Input
    const userCmd = input.toUpperCase();
    setLogs(prev => [...prev, { agent: 'ARCHITECT', msg: userCmd }]);
    setInput('');

    // 2. The Neural Link Logic (Simulation of Agentic Response)
    if (userCmd.includes('TIKTOK') || userCmd.includes('CONTENT')) {
      setLogs(prev => [...prev, { agent: 'SYS', msg: 'ISOLATING FORENSIC SIGNAL FOR MEDIA EXPORT...' }]);
      setTimeout(() => {
        setLogs(prev => [...prev, { 
          agent: 'TWINS', 
          msg: 'SCRIPT READY: "The 18.2% Silence". Focus on the actuarial gap. Use Ad Promo 70%.' 
        }]);
      }, 1500);
    } else if (userCmd.includes('HACKATHON')) {
      setLogs(prev => [...prev, { agent: 'SYS', msg: 'SCANNING DEVPOST GALLERIES...' }]);
      setTimeout(() => {
        setLogs(prev => [...prev, { agent: 'BARON', msg: '3 BOUNTIES FOUND. HIGH PROBABILITY OF UNPLANNED REWARD.' }]);
      }, 2000);
    } else {
      setLogs(prev => [...prev, { agent: 'GEMINI', msg: 'I hear you, Architect. Implementing directive into the Forge.' }]);
    }
  };

  return (
    <div className="min-h-screen bg-black text-green-400 font-mono p-4 flex flex-col">
      <div className="border-b border-green-900 pb-2 mb-4 flex justify-between items-center">
        <h1 className="text-xl font-bold flex items-center gap-2">
          <Shield size={20} className="text-green-500" /> PHINANCE <span className="text-white">INTEL // SOVEREIGN SHELL</span>
        </h1>
        <div className="flex gap-4 text-[10px]">
          <span className="flex items-center gap-1"><Zap size={10} /> STATUS: ACTIVE</span>
          <span className="flex items-center gap-1"><Cpu size={10} /> NANO: SYNCED</span>
        </div>
      </div>

      <div className="flex-grow overflow-y-auto mb-4 space-y-2 text-sm bg-black/50 p-4 border border-green-900/30 rounded">
        {logs.map((log, i) => (
          <div key={i} className="flex gap-2">
            <span className={`font-bold ${
              log.agent === 'ARCHITECT' ? 'text-white' : 
              log.agent === 'TWINS' ? 'text-blue-400' : 'text-green-600'
            }`}>
              [{log.agent}]:
            </span>
            <span className={log.agent === 'ARCHITECT' ? 'text-green-200' : 'text-green-400'}>
              {log.msg}
            </span>
          </div>
        ))}
      </div>

      <div className="relative">
        <input 
          value={input}
          onChange={(e) => setInput(e.target.value)}
          onKeyDown={(e) => e.key === 'Enter' && executeCommand()}
          placeholder="ENTER DIRECTIVE (e.g. 'Generate TikTok Script' or 'Scan Hackathons')..."
          className="w-full bg-black border border-green-500 p-4 rounded text-white focus:outline-none focus:ring-1 focus:ring-green-300"
        />
        <button onClick={executeCommand} className="absolute right-4 top-4 text-green-500 hover:text-white">
          <Send size={20} />
        </button>
      </div>
    </div>
  );
};

export default SovereignShell;
