SPORTS = ["Soccer", "Basketball", "Tennis"]
SUSPICION_THRESHOLD = 0.15  # 15% drop in odds triggers an alert

print("[ARENA PRIME] INITIALIZING GLOBAL ODDS SCANNER...")
